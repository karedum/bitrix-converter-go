# Окружение (dev, master)
CONVERT_ENV=dev

# Порт на котором будет запущен API сервер
CONVERT_API_PORT=8100
CONVERT_API_TIMEOUT=30s
CONVERT_API_IDLE_TIMEOUT=30s

# Директория внутри контейнера куда попадают сконвертированные файлы
CONVERT_SUCCESS_DIRECTORY=/app/upload/success

# Директория внутри контейнера куда попадают скачанные файлы для конвертации
CONVERT_DOWNLOAD_DIRECTORY=/app/upload/download

# Максимальный размер для видео
CONVERT_MAX_VIDEO_SIZE=104857600
# Максимальный размер для документов
CONVERT_MAX_DOCUMENT_SIZE=104857600

# Данные для подключения к RabbitMQ
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_HOST=rabbit
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_QUEUE=main_preview

# Количество воркеров, одновременно обрабатывающих задачи из всех очередей
CONVERT_WORKERS=6
# Максимум одновременно запущенных libreoffice/ffmpeg/convert (0 - по числу CPU)
CONVERT_MAX_PROCESSES=0
# Максимальное время работы одного процесса конвертации
CONVERT_PROCESS_TIMEOUT=10m
# Сколько сконвертированных файлов одной задачи загружаются параллельно.
# 1 - по одному: при параллельной загрузке в одну задачу Битрикс иногда отвечает пустым телом.
CONVERT_UPLOAD_CONCURRENCY=1
# Таймаут одного HTTP-запроса к Битрикс
CONVERT_HTTP_TIMEOUT=5m
# Сколько ждать завершения текущих задач при остановке (должно быть меньше stop_grace_period в docker-compose)
CONVERT_SHUTDOWN_TIMEOUT=4m30s
